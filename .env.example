# Copier ce fichier en .env.local pour le développement local (jamais commité).
# En production/preview, ces mêmes variables se renseignent dans Vercel :
# Project Settings > Environment Variables.

# --- Supabase ---
# Supabase Console > (ton projet) > Connect, ou Settings > API Keys.
# Ces deux valeurs sont publiques par nature (préfixe NEXT_PUBLIC_) : la
# sécurité réelle vient des policies RLS posées dans supabase/schema.sql,
# pas du secret de ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé SECRÈTE Supabase (brique 5a, paiement) : Supabase Console > Project
# Settings > API Keys > « Secret keys » (sb_secret_…). Nécessaire parce que
# la notification de paiement de Systempay et la tâche quotidienne des
# échéances arrivent sans utilisateur connecté. Elle contourne les règles
# d'accès : type « Secret » dans Vercel, JAMAIS de préfixe NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Notifications sur téléphone (Web Push, brique 9a) ---
# Paire de clés VAPID propre au site. La clé publique peut être visible ;
# la clé privée est un SECRET du serveur (jamais de préfixe NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Référencement ---
# "oui" uniquement sur le domaine définitif : ouvre l'indexation par les
# moteurs de recherche (voir src/app/robots.ts).
NEXT_PUBLIC_INDEXATION=

# --- Paiement Systempay (brique 5a) ---
# Back Office Systempay > Paramétrage > Boutique > onglet « Clés d'API REST ».
# Mettre les clés de TEST (le site se déclare en mode test tout seul quand le
# mot de passe commence par « testpassword_ »).
# En attendant les clés de la boutique Aide & Garde, on peut utiliser la
# boutique de démonstration publiée dans la documentation Systempay :
#   SYSTEMPAY_BOUTIQUE=73239078
#   SYSTEMPAY_MOT_DE_PASSE=testpassword_SbEbeOueaMDyg8Rtei1bSaiB5lms9V0ZDjzldGXGAnIwH
#   NEXT_PUBLIC_SYSTEMPAY_CLE_PUBLIQUE=73239078:testpublickey_Zr3fXIKKx0mLY9YNBQEan42ano2QsdrLuyb2W54QWmUJQ
SYSTEMPAY_BOUTIQUE=
# Mot de passe de l'API : type « Secret » dans Vercel.
SYSTEMPAY_MOT_DE_PASSE=
# Clé publique du formulaire (publique par nature).
NEXT_PUBLIC_SYSTEMPAY_CLE_PUBLIQUE=

# Secret de la tâche quotidienne des échéances (vercel.json > crons) : une
# longue chaîne aléatoire, type « Secret ». Vercel l'envoie tout seul.
CRON_SECRET=
