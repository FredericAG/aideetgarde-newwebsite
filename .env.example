# Copier ce fichier en .env.local pour le développement local (jamais commité).
# En production/preview, ces mêmes variables se renseignent dans Vercel :
# Project Settings > Environment Variables.

# --- Supabase ---
# Supabase Console > (ton projet) > Connect, ou Settings > API Keys.
# Ces deux valeurs sont publiques par nature (préfixe NEXT_PUBLIC_) : la
# sécurité réelle vient des policies RLS posées dans supabase/schema.sql,
# pas du secret de ces valeurs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Pas de clé secrète (secret key / service_role) nécessaire pour l'instant :
# toutes les opérations de la brique 1 passent par la session de
# l'utilisateur connecté et les policies RLS. Une clé secrète ne sera
# introduite que si une brique future a besoin d'un accès administrateur
# qui contourne délibérément RLS (ex. un futur back-office).

# --- Notifications sur téléphone (Web Push, brique 9a) ---
# Paire de clés VAPID propre au site. La clé publique peut être visible ;
# la clé privée est un SECRET du serveur (jamais de préfixe NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Référencement ---
# "oui" uniquement sur le domaine définitif : ouvre l'indexation par les
# moteurs de recherche (voir src/app/robots.ts).
NEXT_PUBLIC_INDEXATION=
